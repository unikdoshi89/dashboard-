def generate_project_report_html(
    db: Session,
    project_id: int,
    jira_total: int = 0,
    jira_uat: int = 0,
    jira_prod: int = 0,
    jira_sit: int = 0,
    jira_issues=None,
    jira_features=None,
):
    """
    Generate a complete interactive HTML report.

    IMPORTANT:
    Quality Confidence Score is ALWAYS obtained from
    calculate_quality_confidence_score() so that the HTML report
    uses the same calculation source as the dashboard/API/PDF.
    """

    jira_issues = jira_issues or []
    jira_features = jira_features or []

    # ==========================================================
    # PROJECT
    # ==========================================================

    project = (
        db.query(Project)
        .filter(
            Project.id == project_id,
            Project.active.is_(True),
        )
        .first()
    )

    if not project:
        raise ValueError("Project not found")

    # ==========================================================
    # SINGLE SOURCE OF TRUTH
    # ==========================================================

    score_data = calculate_quality_confidence_score(
        db,
        project_id,
    )

    overall_score = score_data.get("score")
    overall_status = score_data.get(
        "status",
        "NO_DATA",
    )

    # ==========================================================
    # HELPERS
    # ==========================================================

    def esc(value):
        if value is None:
            return "—"

        return escape(str(value))

    def fmt_number(value, decimals=2):
        if value is None:
            return "—"

        try:
            return f"{float(value):.{decimals}f}"
        except (
            TypeError,
            ValueError,
        ):
            return "—"

    def status_class(status):
        status = str(
            status or "NO_DATA"
        ).upper()

        if status in (
            "STRONG",
            "GREEN",
            "PASS",
            "GOOD",
        ):
            return "status-strong"

        if status in (
            "MODERATE",
            "AMBER",
            "WARNING",
        ):
            return "status-moderate"

        if status in (
            "LOW",
            "RED",
            "CRITICAL",
            "FAIL",
        ):
            return "status-low"

        return "status-no-data"

    def get_metric_display_value(
        metric_value,
    ):
        if not metric_value:
            return "NO_DATA"

        value = _safe_float(
            metric_value.value
        )

        notes = metric_value.notes

        if (
            value is None
            or value == 0
            or _notes_indicate_no_data(notes)
        ):
            return "NO_DATA"

        return fmt_number(value)

    # ==========================================================
    # METRIC DATA
    # ==========================================================

    categories = (
        db.query(MetricCategory)
        .order_by(
            MetricCategory.display_order
        )
        .all()
    )

    metric_sections = []

    for category in categories:

        project_metrics = (
            db.query(
                ProjectMetric,
                MetricDefinition,
                MetricValue,
            )
            .join(
                MetricDefinition,
                ProjectMetric.metric_definition_id
                == MetricDefinition.id,
            )
            .outerjoin(
                MetricValue,
                MetricValue.project_metric_id
                == ProjectMetric.id,
            )
            .filter(
                ProjectMetric.project_id
                == project_id,
                ProjectMetric.enabled.is_(True),
                MetricDefinition.category_id
                == category.id,
            )
            .order_by(
                MetricDefinition.display_order
            )
            .all()
        )

        if not project_metrics:
            continue

        rows = []

        for (
            project_metric,
            definition,
            metric_value,
        ) in project_metrics:

            value_display = (
                get_metric_display_value(
                    metric_value
                )
            )

            metric_status = (
                metric_value.status
                if metric_value
                and metric_value.status
                else "NO_DATA"
            )

            notes = (
                metric_value.notes
                if metric_value
                else None
            )

            if (
                metric_value is None
                or _safe_float(
                    metric_value.value
                ) in (None, 0)
                or _notes_indicate_no_data(notes)
            ):
                metric_status = "NO_DATA"

            rows.append(
                f"""
                <tr>
                    <td>
                        <strong>{esc(definition.name)}</strong>
                        <div class="metric-description">
                            {esc(definition.description)}
                        </div>
                    </td>

                    <td>
                        {esc(value_display)}
                    </td>

                    <td>
                        {esc(definition.unit)}
                    </td>

                    <td>
                        {fmt_number(definition.default_target)}
                    </td>

                    <td>
                        {fmt_number(definition.warning_threshold)}
                    </td>

                    <td>
                        {fmt_number(definition.critical_threshold)}
                    </td>

                    <td>
                        <span class="status {status_class(metric_status)}">
                            {esc(metric_status)}
                        </span>
                    </td>

                    <td>
                        {esc(notes)}
                    </td>
                </tr>
                """
            )

        metric_sections.append(
            f"""
            <section class="section-card">
                <div class="section-heading">
                    <div>
                        <h3>{esc(category.name)}</h3>
                        <span class="category-weight">
                            Category Weight:
                            {fmt_number(category.weight)}%
                        </span>
                    </div>
                </div>

                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Metric</th>
                                <th>Value</th>
                                <th>Unit</th>
                                <th>Target</th>
                                <th>Warning</th>
                                <th>Critical</th>
                                <th>Status</th>
                                <th>Notes</th>
                            </tr>
                        </thead>

                        <tbody>
                            {"".join(rows)}
                        </tbody>
                    </table>
                </div>
            </section>
            """
        )

    # ==========================================================
    # AUTOMATION
    # ==========================================================

    releases = (
        db.query(AutomationRelease)
        .filter(
            AutomationRelease.project_id
            == project_id
        )
        .order_by(
            AutomationRelease.release_order,
            AutomationRelease.id,
        )
        .all()
    )

    automation_rows = []

    total_rtb = 0
    total_test_cases = 0
    total_automatable = 0
    total_automated = 0

    for release in releases:

        details = (
            db.query(AutomationDetail)
            .filter(
                AutomationDetail.release_id
                == release.id
            )
            .order_by(
                AutomationDetail.id
            )
            .all()
        )

        for detail in details:

            automatable = (
                detail.automatable or 0
            )

            automated = (
                detail.automated or 0
            )

            automation_percentage = (
                (
                    automated
                    / automatable
                ) * 100
                if automatable > 0
                else None
            )

            automation_rows.append(
                f"""
                <tr>
                    <td>{esc(release.release_name)}</td>
                    <td>{esc(detail.pod)}</td>
                    <td>{detail.requirements_rtb or 0}</td>
                    <td>{detail.test_cases or 0}</td>
                    <td>{automatable}</td>
                    <td>{automated}</td>
                    <td>
                        {
                            (
                                f"{automation_percentage:.2f}%"
                                if automation_percentage is not None
                                else "—"
                            )
                        }
                    </td>
                </tr>
                """
            )

            total_rtb += (
                detail.requirements_rtb or 0
            )

            total_test_cases += (
                detail.test_cases or 0
            )

            total_automatable += automatable
            total_automated += automated

    total_automation_percentage = (
        (
            total_automated
            / total_automatable
        ) * 100
        if total_automatable > 0
        else None
    )

    # ==========================================================
    # RTM
    # ==========================================================

    latest_upload = (
        db.query(AutomationUploadBatch)
        .filter(
            AutomationUploadBatch.project_id
            == project_id
        )
        .order_by(
            AutomationUploadBatch.uploaded_at.desc(),
            AutomationUploadBatch.id.desc(),
        )
        .first()
    )

    rtm_rows = []

    if latest_upload:

        uploaded_test_cases = (
            db.query(UploadedTestCase)
            .filter(
                UploadedTestCase.upload_batch_id
                == latest_upload.id
            )
            .order_by(
                UploadedTestCase.jira_id,
                UploadedTestCase.id,
            )
            .all()
        )

        jira_summary = defaultdict(
            lambda: {
                "total": 0,
                "automatable": 0,
                "automated": 0,
            }
        )

        for test_case in uploaded_test_cases:

            jira_id = (
                str(test_case.jira_id).strip()
                if test_case.jira_id
                else "NO JIRA ID"
            )

            jira_summary[jira_id][
                "total"
            ] += 1

            if _is_yes(
                test_case.automatable
            ):
                jira_summary[jira_id][
                    "automatable"
                ] += 1

            if _is_yes(
                test_case.automated
            ):
                jira_summary[jira_id][
                    "automated"
                ] += 1

        for jira_id, summary in sorted(
            jira_summary.items()
        ):

            total = summary["total"]
            automatable = summary["automatable"]
            automated = summary["automated"]

            not_automated = max(
                automatable - automated,
                0,
            )

            percentage = (
                (
                    automated
                    / automatable
                ) * 100
                if automatable > 0
                else None
            )

            rtm_rows.append(
                f"""
                <tr>
                    <td>{esc(jira_id)}</td>
                    <td>{total}</td>
                    <td>{automatable}</td>
                    <td>{automated}</td>
                    <td>{not_automated}</td>
                    <td>
                        {
                            (
                                f"{percentage:.2f}%"
                                if percentage is not None
                                else "—"
                            )
                        }
                    </td>
                </tr>
                """
            )

    # ==========================================================
    # JIRA ISSUES
    # ==========================================================

    jira_issue_rows = []

    for issue in jira_issues:

        fields = issue.get(
            "fields",
            {},
        )

        labels = (
            fields.get("labels")
            or []
        )

        environment = get_issue_environment(
            labels=labels,
            uat_label=(
                jira_config.uat_label
                if jira_config
                else None
            ),
            prod_label=(
                jira_config.prod_label
                if jira_config
                else None
            ),
        )

        jira_issue_rows.append(
            f"""
            <tr>
                <td>{esc(issue.get("key"))}</td>
                <td>{esc(fields.get("summary"))}</td>
                <td>
                    {esc(
                        fields.get(
                            "status",
                            {}
                        ).get("name")
                    )}
                </td>
                <td>
                    {esc(
                        fields.get(
                            "priority",
                            {}
                        ).get("name")
                    )}
                </td>
                <td>{esc(environment or "SIT")}</td>
                <td>
                    {esc(
                        fields.get(
                            "assignee",
                            {}
                        ).get("displayName")
                    )}
                </td>
            </tr>
            """
        )

    # ==========================================================
    # JIRA FEATURES
    # ==========================================================

    jira_feature_rows = []

    for issue in jira_features:

        fields = issue.get(
            "fields",
            {},
        )

        jira_feature_rows.append(
            f"""
            <tr>
                <td>{esc(issue.get("key"))}</td>
                <td>{esc(fields.get("summary"))}</td>
                <td>
                    {esc(
                        fields.get(
                            "status",
                            {}
                        ).get("name")
                    )}
                </td>
                <td>
                    {esc(
                        fields.get(
                            "priority",
                            {}
                        ).get("name")
                    )}
                </td>
                <td>
                    {esc(
                        fields.get(
                            "assignee",
                            {}
                        ).get("displayName")
                    )}
                </td>
                <td>
                    {esc(
                        fields.get(
                            "customfield_10008"
                        )
                    )}
                </td>
            </tr>
            """
        )

    # ==========================================================
    # CATEGORY SCORE CARDS
    #
    # IMPORTANT:
    # Scores here come directly from score_data returned by
    # calculate_quality_confidence_score().
    # ==========================================================

    category_cards = []

    for category in score_data.get(
        "categories",
        [],
    ):

        category_score = (
            category.get("score")
        )

        category_status = (
            "NO_DATA"
            if category_score is None
            else (
                "STRONG"
                if category_score >= 80
                else (
                    "MODERATE"
                    if category_score >= 60
                    else "LOW"
                )
            )
        )

        category_cards.append(
            f"""
            <div class="score-card">
                <div class="score-card-title">
                    {esc(category.get("category_name"))}
                </div>

                <div class="score-value">
                    {
                        (
                            f"{float(category_score):.2f}"
                            if category_score is not None
                            else "0.00"
                        )
                    }
                </div>

                <div class="score-weight">
                    Weight:
                    {fmt_number(category.get("weight"))}%
                </div>

                <span class="status {status_class(category_status)}">
                    {category_status}
                </span>
            </div>
            """
        )

    # ==========================================================
    # CALCULATION DETAILS
    # ==========================================================

    calculation_rows = []

    for category in score_data.get(
        "categories",
        [],
    ):

        category_name = category.get(
            "category_name"
        )

        category_weight = category.get(
            "weight",
            0,
        )

        category_score = category.get(
            "score"
        )

        calculation_rows.append(
            f"""
            <tr>
                <td>
                    {esc(category_name)}
                </td>

                <td>
                    {fmt_number(category_weight)}%
                </td>

                <td>
                    {
                        (
                            f"{float(category_score):.2f}"
                            if category_score is not None
                            else "0.00"
                        )
                    }
                </td>

                <td>
                    {
                        (
                            f"{float(category_score):.2f}"
                            if category_score is not None
                            else "0.00"
                        )
                    }
                    ×
                    {fmt_number(category_weight)}%
                </td>
            </tr>
            """
        )

    # ==========================================================
    # JIRA CONFIG
    # ==========================================================

    jira_config = (
        db.query(JiraConfiguration)
        .filter(
            JiraConfiguration.project_id
            == project_id,
            JiraConfiguration.active.is_(True),
        )
        .first()
    )

    jira_status = (
        "CONFIGURED"
        if jira_config
        else "NOT CONFIGURED"
    )

    jira_jql = (
        jira_config.jql
        if jira_config
        else None
    )

    feature_jql = (
        jira_config.feature_jql
        if jira_config
        else None
    )

    # ==========================================================
    # HTML
    # ==========================================================

    score_display = (
        f"{float(overall_score):.2f}"
        if overall_score is not None
        else "0.00"
    )

    generated_at = (
        datetime.now().strftime(
            "%d-%b-%Y %H:%M"
        )
    )

    return f"""
<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
/>

<title>
    QE Governance - {esc(project.name)}
</title>

<style>

* {{
    box-sizing: border-box;
}}

body {{
    margin: 0;
    background: #f8fafc;
    color: #1e293b;
    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Arial,
        sans-serif;
}}

.header {{
    background:
        linear-gradient(
            135deg,
            #2563eb,
            #4338ca
        );
    color: white;
    padding: 28px 40px;
}}

.header-inner {{
    max-width: 1400px;
    margin: auto;
}}

.header h1 {{
    margin: 0;
    font-size: 28px;
}}

.header p {{
    margin: 6px 0 0;
    color: #dbeafe;
}}

