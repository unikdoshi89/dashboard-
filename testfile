    }}

    .tabs {{
        overflow-x: auto;
    }}

    .tab-button {{
        white-space: nowrap;
    }}

}}

</style>

</head>

<body>

<header class="header">

    <div class="header-inner">

        <h1>
            QE Governance
        </h1>

        <p>
            Quality Engineering Dashboard & Report
        </p>

        <div class="project-meta">

            <span>
                <strong>Project:</strong>
                {esc(project.name)}
            </span>

            <span>
                <strong>Key:</strong>
                {esc(project.project_key)}
            </span>

            <span>
                <strong>Generated:</strong>
                {generated_at}
            </span>

        </div>

    </div>

</header>


<div class="container">

    <!-- ======================================================
         TABS
         ====================================================== -->

    <div class="tabs">

        <button
            class="tab-button active"
            onclick="openTab(event, 'dashboard')"
        >
            Dashboard
        </button>

        <button
            class="tab-button"
            onclick="openTab(event, 'automation')"
        >
            Automation Details
        </button>

        <button
            class="tab-button"
            onclick="openTab(event, 'jira')"
        >
            Jira Details
        </button>

        <button
            class="tab-button"
            onclick="openTab(event, 'calculation')"
        >
            Calculation Details
        </button>

    </div>


    <!-- ======================================================
         DASHBOARD
         ====================================================== -->

    <div
        id="dashboard"
        class="tab-content active"
    >

        <div class="summary-grid">

            <div class="summary-card">

                <div class="summary-label">
                    Quality Confidence Score
                </div>

                <div class="summary-value">
                    {score_display}
                </div>

                <span class="status {status_class(overall_status)}">
                    {esc(overall_status)}
                </span>

            </div>


            <div class="summary-card">

                <div class="summary-label">
                    Jira Total Bugs
                </div>

                <div class="summary-value">
                    {jira_total}
                </div>

            </div>


            <div class="summary-card">

                <div class="summary-label">
                    Production Bugs
                </div>

                <div class="summary-value">
                    {jira_prod}
                </div>

            </div>


            <div class="summary-card">

                <div class="summary-label">
                    UAT Bugs
                </div>

                <div class="summary-value">
